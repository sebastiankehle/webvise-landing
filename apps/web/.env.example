# Database
DATABASE_URL=postgresql://user:password@localhost:5432/webvise

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=your-secret-key-min-32-characters
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3001

# Posthog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Environment
NODE_ENV=development

# Resend email API key
RESEND_API_KEY=re_your_resend_api_key

# Google PageSpeed Insights API key for /wp-health-report
GOOGLE_PAGESPEED_API_KEY=your_pagespeed_api_key

# Vercel AI Gateway key for the AI chat
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Google Search Console verification code
GOOGLE_VERIFICATION_CODE=your_google_verification_code

# Attio CRM API key
ATTIO_API_KEY=

# Upstash Redis for durable rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where contact and signup notifications go (default mail@webvise.io)
CONTACT_EMAIL_TO=

# Override the AI chat system prompt
AI_CHAT_SYSTEM_PROMPT=

# Signs newsletter confirmation and unsubscribe tokens (32+ chars; falls back to BETTER_AUTH_SECRET)
EMAIL_TOKEN_SECRET=
