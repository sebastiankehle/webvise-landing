# Database
DATABASE_URL=postgresql://user:password@localhost:5432/webvise

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=your-secret-key-min-32-characters
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3001

# Posthog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Environment
NODE_ENV=development

# Resend email API key
RESEND_API_KEY=re_your_resend_api_key

# Google PageSpeed Insights API key for /wp-health-report
GOOGLE_PAGESPEED_API_KEY=your_pagespeed_api_key

# Vercel AI Gateway key for the AI chat
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Google Search Console verification code
GOOGLE_VERIFICATION_CODE=your_google_verification_code
