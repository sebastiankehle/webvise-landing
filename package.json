{
  "name": "webvise-app",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "pnpm --filter native dev",
    "dev:web": "pnpm --filter web dev",
    "db:push": "pnpm --filter @webvise-app/db db:push",
    "db:studio": "pnpm --filter @webvise-app/db db:studio",
    "db:generate": "pnpm --filter @webvise-app/db db:generate",
    "db:migrate": "pnpm --filter @webvise-app/db db:migrate",
    "db:start": "pnpm --filter @webvise-app/db db:start",
    "db:watch": "pnpm --filter @webvise-app/db db:watch",
    "db:stop": "pnpm --filter @webvise-app/db db:stop",
    "db:down": "pnpm --filter @webvise-app/db db:down",
    "test": "turbo test",
    "check": "ultracite fix",
    "format": "ultracite format",
    "lint": "ultracite check",
    "verify": "pnpm check-types && pnpm lint && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  },
  "dependencies": {
    "@webvise-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^22.13.14",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "ultracite": "^7.6.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.1.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.14",
      "defu": "6.1.7",
      "dompurify": "3.4.9",
      "effect": "3.21.3",
      "esbuild": "0.28.0",
      "hono": "4.12.25",
      "icu-minify": "4.13.0",
      "ip-address": "10.2.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "mermaid": "11.15.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.15",
      "uuid": "11.1.1",
      "vite": "8.0.16",
      "vitest": "4.1.8"
    }
  }
}
